---
import { identity, contactLinks } from "../data/portfolio";
import SystemSketch from "./SystemSketch.astro";
import ArrowIcon from "./ArrowIcon.astro";
---

<section class="home-hero" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow">
      {identity.name} <span class="eyebrow-divider">/</span> Toronto, Canada
    </p>
    <h1 id="hero-title">
      Practical AI.
      <br />
      Built with <span class="text-accent">care.</span>
    </h1>
    <p class="hero-role">{identity.headline.split(" · ")[0]}</p>
    <p class="hero-intro">
      I work across language models, search, and the ML infrastructure behind
      them. At Thomson Reuters Labs, I help turn research and domain knowledge
      into useful AI systems.
    </p>
    <div class="action-row">
      <a href="/work" class="button button-primary">
        Explore my work <ArrowIcon kind="external" />
      </a>
      <a href={contactLinks.email} class="text-link">
        Get in touch <ArrowIcon kind="external" />
      </a>
    </div>
    <p class="hero-note">
      From production features to the workflows that help teams improve them.
    </p>
  </div>
  <SystemSketch />
</section>
