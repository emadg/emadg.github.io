---
import { career, featuredWork, expertise, resume } from "../data/portfolio";
import { STAGE_LABEL, renderInline } from "../lib/resume";
import ArrowIcon from "./ArrowIcon.astro";
const featuredIds = new Set(featuredWork.map((work) => work.project.id));
---

<section
  class="section-block"
  id="experience"
  aria-labelledby="experience-title"
>
  <div class="section-heading">
    <div>
      <p class="eyebrow">Experience</p>
      <h2 id="experience-title">The broader picture.</h2>
    </div>
    <p class="section-description">
      Eight years working across research, product features, and the systems
      that connect them.
    </p>
  </div>
  <div class="career-list">
    {career.map((job) => (
      <article class="career-entry">
        <header class="career-meta">
          <p class="career-company">{job.company}</p>
          <p class="quiet-metadata">{job.period}</p>
          <p class="quiet-metadata">{job.location}</p>
        </header>
        <div class="career-content">
          <h3>{job.role}</h3>
          <p
            class="career-description"
            set:html={renderInline(job.description)}
          />
          <h4 class="small-label">Work projects</h4>
          <div class="career-projects">
            {job.projects.map((project) =>
              featuredIds.has(project.id) ? (
                <a class="career-project-link" href={`#${project.id}`}>
                  <span>
                    <strong>{project.name}</strong>
                    <span class="metadata">
                      <span>{project.period}</span>
                      <span>{STAGE_LABEL[project.stage]}</span>
                    </span>
                  </span>
                  <span class="career-project-action">
                    Read story <ArrowIcon />
                  </span>
                </a>
              ) : (
                <details class="career-project" id={project.id}>
                  <summary>
                    <span>
                      <strong>{project.name}</strong>
                      <span class="metadata">
                        <span>{project.period}</span>
                        <span>{STAGE_LABEL[project.stage]}</span>
                      </span>
                    </span>
                    <span class="disclosure-icon" aria-hidden="true">
                      +
                    </span>
                  </summary>
                  <div class="details-content">
                    <p set:html={renderInline(project.description)} />
                    {project.highlights?.length ? (
                      <ul>
                        {project.highlights.map((highlight) => (
                          <li set:html={renderInline(highlight)} />
                        ))}
                      </ul>
                    ) : null}
                    <p class="technology-line">
                      <strong>Tools & technologies:</strong>{" "}
                      {project.tech.join(" · ")}
                    </p>
                  </div>
                </details>
              ),
            )}
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
<section class="section-block" id="expertise" aria-labelledby="expertise-title">
  <div class="section-heading">
    <div>
      <p class="eyebrow">Technical expertise</p>
      <h2 id="expertise-title">Capabilities, with context.</h2>
    </div>
    <p class="section-description">
      The tools matter most when they support a useful result.
    </p>
  </div>
  <div class="expertise-grid">
    {expertise.map((group) => (
      <article class="expertise-group">
        <h3>{group.category}</h3>
        <p>{group.description}</p>
        <p class="skill-list">{group.featured.join(" · ")}</p>
        {group.more.length > 0 && (
          <details class="skill-details">
            <summary>
              More tools & skills{" "}
              <span class="disclosure-icon" aria-hidden="true">
                +
              </span>
            </summary>
            <p class="skill-list">{group.more.join(" · ")}</p>
          </details>
        )}
        <a class="text-link" href={`#${group.evidence}`}>
          {group.evidenceLabel} <ArrowIcon />
        </a>
      </article>
    ))}
  </div>
</section>
<section
  class="section-block credentials-grid"
  id="education"
  aria-label="Education and publications"
>
  <div>
    <p class="eyebrow">Education</p>
    <h2 class="credentials-heading">Foundations.</h2>
    <div class="education-list">
      {resume.education.map((education) => (
        <article>
          <h3>{education.degree}</h3>
          <p>{education.institution}</p>
          <p class="quiet-metadata">
            {education.period} · {education.location}
          </p>
          {education.note && <p class="education-note">{education.note}</p>}
          {education.grade && (
            <p class="quiet-metadata">GPA: {education.grade}</p>
          )}
        </article>
      ))}
    </div>
  </div>
  <div id="publications">
    <p class="eyebrow">Publications</p>
    <h2 class="credentials-heading">Research & writing.</h2>
    <ol class="publication-list">
      {resume.publications.map((publication) => (
        <li>
          <h3>{publication.title}</h3>
          <p class="quiet-metadata">
            {publication.venue} · {publication.year}
            {publication.note ? ` · ${publication.note}` : ""}
          </p>
        </li>
      ))}
    </ol>
  </div>
</section>
