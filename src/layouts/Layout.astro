---
import '../styles/global.css';
import NetworkBackground from '../components/NetworkBackground.astro';
import Nav from '../components/Nav.astro';

interface Props {
	title: string;
	description?: string;
	scrollSnap?: boolean;
	/** Open Graph image: site path (e.g. "/og/foo.png") or absolute URL. 1200x630. */
	image?: string;
	imageAlt?: string;
	/** Open Graph type: "website" for pages, "article" for posts and project write-ups. */
	type?: 'website' | 'article';
	/** ISO date for article:published_time. */
	publishedTime?: string;
}

const {
	title,
	description = "Emad Gohari, senior ML and research engineer: NLP, LLM and agentic systems. Portfolio, projects and resume.",
	scrollSnap = false,
	image = '/og-default.png',
	imageAlt = 'Emad Gohari, Senior Research Engineer, AI and ML',
	type = 'website',
	publishedTime,
} = Astro.props;

const site = Astro.site ?? new URL('https://emadgohari.com');
const canonicalURL = new URL(Astro.url.pathname, site);
const imageURL = new URL(image, site);
---

<!doctype html>
<html lang="en" class="scroll-smooth" style={scrollSnap ? "scroll-snap-type: y proximity;" : ""}>
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="canonical" href={canonicalURL} />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<!-- Open Graph / social cards -->
		<meta property="og:type" content={type} />
		<meta property="og:site_name" content="Emad Gohari" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={imageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={imageAlt} />
		{publishedTime && <meta property="article:published_time" content={publishedTime} />}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageURL} />
		<meta name="twitter:image:alt" content={imageAlt} />
		
		<!-- Theme Script to prevent flash of wrong theme -->
		<script is:inline>
			const theme = (() => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
					return 'dark';
				}
				return 'light';
			})();
		
			if (theme === 'dark') {
				document.documentElement.classList.add('dark');
			} else {
				document.documentElement.classList.remove('dark');
			}
		
			window.localStorage.setItem('theme', theme);
		</script>
	</head>
	<body class="min-h-screen flex flex-col items-center relative overflow-x-hidden">
		<!-- Animated Canvas Background -->
		<NetworkBackground />
		
		<!-- Central Frosted Glass Panel -->
		<div class="w-full max-w-5xl min-h-screen flex flex-col items-center bg-bg-panel backdrop-blur-[5px] border-x border-border-subtle shadow-2xl relative z-10 transform-gpu">
			
			<Nav scrollSnap={scrollSnap} />

			<main class="w-full px-8 sm:px-12 py-12 md:py-24 flex-grow flex flex-col">
				<slot />
			</main>

			<!-- Minimal Footer inside the panel -->
			<footer class="w-full px-8 sm:px-12 py-8 mt-auto border-t border-border-subtle">
				<div class="flex justify-between items-center text-sm text-text-muted">
				<p>&copy; {new Date().getFullYear()} Emad Gohari</p>
				<div class="flex gap-4">
						<a href="https://github.com/emadg" target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">GitHub</a>
						<a href="https://www.linkedin.com/in/emad-gohari" target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">LinkedIn</a>
					</div>
				</div>
			</footer>
		</div>
	</body>
</html>
