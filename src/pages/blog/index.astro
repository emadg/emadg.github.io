---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  });
---

<Layout
  title="Writing | Emad Gohari"
  description="Notes on machine learning, AI systems, and the engineering around them."
>
  <section class="writing-page" aria-labelledby="writing-title">
    <header class="writing-heading">
      <p class="eyebrow">Writing</p>
      <h1 id="writing-title">Notes from the work.</h1>
      <p>
        Thoughts on machine learning, AI systems, and the engineering that helps
        them hold up in practice.
      </p>
    </header>
    <div class="writing-list">
      {posts.length ? (
        posts.map((post) => (
          <a
            class="writing-card"
            href={`/blog/${post.id.replace(/\.md$/, "")}/`}
          >
            <time
              class="quiet-metadata"
              datetime={post.data.pubDate.toISOString()}
            >
              {formatDate(post.data.pubDate)}
            </time>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
            {post.data.tags?.length ? (
              <p class="quiet-metadata">{post.data.tags.join(" · ")}</p>
            ) : null}
            <span class="text-link">
              Read article <span aria-hidden="true">→</span>
            </span>
          </a>
        ))
      ) : (
        <p class="quiet-metadata">Notes are on the way.</p>
      )}
    </div>
  </section>
</Layout>
