---
import { loadResume, renderInline, STAGE_LABEL, type Project } from '../lib/resume';

const resumeData = loadResume();
const contact = resumeData.basics;
const ats = process.env.RESUME_LAYOUT === 'ats';
// Keep formatting decisions local to the PDF; the portfolio keeps its emphasis.
const inline = (text: string | null | undefined) =>
	renderInline(ats ? text?.replace(/\*\*(.+?)\*\*/g, '$1') : text);
const stageLabel = (project: Project) => STAGE_LABEL[project.stage] ?? project.stage;
---

<!doctype html>
<html lang="en">
<head>
	<meta charset="UTF-8" />
	<title>{contact.name} - Resume</title>
	<meta name="author" content={contact.name} />
	<meta name="description" content={contact.headline} />
	<style>
		*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
		@page { size: Letter; margin: 0.45in 0.5in; }
		html {
			font-family: Arial, 'Liberation Sans', sans-serif;
			font-size: 11pt; line-height: 1.35; color: #000;
			background: #fff;
			-webkit-print-color-adjust: exact; print-color-adjust: exact;
		}
		a { color: inherit; text-decoration: none; overflow-wrap: anywhere; }
		strong { font-weight: 700; }

		/* All spacing lives here, shared by browser preview and PDF output. */
		header { margin-bottom: 12pt; border-bottom: 1pt solid #000; padding-bottom: 8pt; break-inside: avoid; }
		.name-row { display: flex; justify-content: space-between; align-items: baseline; gap: 12pt; }
		h1 { font-size: 22pt; line-height: 1.15; flex-shrink: 0; }
		.title { font-size: 11pt; text-align: right; }
		.contact-row { display: flex; flex-wrap: wrap; gap: 4pt 12pt; margin-top: 7pt; font-size: 10pt; }
		.contact-row > * { display: inline-flex; align-items: baseline; gap: 4pt; min-width: 0; max-width: 100%; }
		.contact-row svg { flex-shrink: 0; width: 9pt; height: 9pt; align-self: center; }

		section { margin-bottom: 12pt; }
		section h2 {
			font-family: Georgia, 'Liberation Serif', serif; font-size: 13pt;
			font-weight: 700; text-transform: uppercase; word-spacing: 0.12em;
			border-bottom: 0.5pt solid #888; padding-bottom: 3pt; margin-bottom: 6pt;
			display: flex; align-items: center; gap: 6pt; break-after: avoid;
		}
		section h2::before { content: ''; width: 2pt; height: 11pt; background: #000; flex-shrink: 0; }
		.summary { orphans: 3; widows: 3; }
		.skills-row { margin-bottom: 2pt; break-inside: avoid; }
		.category, .label { font-weight: 700; }

		.job { margin-bottom: 12pt; }
		.job-head { break-inside: avoid; break-after: avoid; margin-bottom: 6pt; }
		.entry { margin-bottom: 8pt; break-inside: avoid; }
		.entry-header, .project-header { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 2pt 10pt; }
		h3, h4, h5 { font-size: 11pt; font-weight: 700; min-width: 0; max-width: 100%; flex: 1 1 auto; }
		.period { font-size: 10pt; white-space: nowrap; flex-shrink: 0; margin-left: auto; }
		.entry-sub, .entry-note, .project-meta, .project-tech, .pub-meta { font-size: 10pt; }
		.entry-desc { margin-top: 3pt; orphans: 3; widows: 3; }
		.entry-note { margin-top: 2pt; }

		/* Plain project entries: no container border, fill, or badge styling. */
		.project { margin: 0 0 8pt 9pt; break-inside: avoid; }
		.project.can-split { break-inside: auto; }
		.project-header { break-inside: avoid; break-after: avoid; }
		.stage { font-size: 10pt; font-weight: 400; }
		.project-desc { margin-top: 3pt; orphans: 3; widows: 3; }
		.project-highlights { margin: 3pt 0 0 14pt; }
		.project-highlights li { orphans: 2; widows: 2; }
		.project-tech { margin-top: 3pt; }
		.pub { margin-bottom: 7pt; break-inside: avoid; }
		.pub-title { font-weight: 700; }

		.projects-heading { font-size: 10pt; font-weight: 700; margin-top: 7pt; }
		.contact-info h2 { font-size: 11pt; margin-top: 7pt; margin-bottom: 3pt; }
		.contact-info .contact-row { margin-top: 0; }

		/* Default typography separates titles from descriptions and metadata. */
		.clean { font-size: 10pt; line-height: 1.35; }
		.clean h1 { font-size: 24pt; }
		.clean .title { font-size: 11.5pt; line-height: 1.25; }
		.clean .contact-row { font-size: 9pt; gap: 4pt 10pt; }
		.clean .contact-row svg { width: 8pt; height: 8pt; }
		.clean h3 { font-size: 11.5pt; }
		.clean .project-title { font-size: 10.5pt; text-indent: -0.65em; }
		.clean .period, .clean .entry-sub, .clean .entry-note,
		.clean .project-tech, .clean .pub-meta, .clean .stage { font-size: 9pt; }
		.clean .projects-heading { font-size: 9pt; text-transform: uppercase; margin-top: 7pt; }
		.clean .job + .job > .job-head { border-top: 0.5pt solid #aaa; padding-top: 10pt; }
		.clean .pub-title { font-size: 10.5pt; }

		/* ATS uses a linear text flow; all contact information is in the body. */
		.ats header { border: 0; padding: 0; }
		.ats .name-row, .ats .contact-row, .ats .contact-row > *,
		.ats .entry-header, .ats .project-header { display: block; }
		.ats .title { display: block; text-align: left; margin-top: 3pt; }
		.ats .contact-row > * { margin-bottom: 2pt; }
		.ats h2 { font-family: inherit; font-size: 14.5pt; line-height: 1.25; border: 0; padding: 0; display: block; text-transform: none; word-spacing: normal; }
		.ats .contact-info h2 { margin-bottom: 5pt; }
		.ats h2::before { content: none; }
		.ats .period { display: block; white-space: normal; margin-left: 0; }
		.ats .project { margin-left: 0; }
		.ats .project-meta { break-after: avoid; }
	</style>
</head>
<body class:list={{ ats, clean: !ats }} data-resume-layout={ats ? 'ats' : 'clean'}>

	<!-- Header -->
	<header>
		<div class="name-row">
			<h1>{contact.name}</h1>
			<span class="title">{contact.headline}</span>
		</div>
		{ats ? (
			<div class="contact-info">
				<h2>&gt; Contact Info</h2>
				<div class="contact-row">
					<div><strong>Email:</strong> <a href={`mailto:${contact.email}`}>{contact.email}</a></div>
					<div><strong>GitHub:</strong> <a href={`https://${contact.github}`}>{contact.github}</a></div>
					<div><strong>LinkedIn:</strong> <a href={`https://${contact.linkedin}`}>{contact.linkedin}</a></div>
					<div><strong>Website:</strong> <a href={`https://${contact.website}`}>{contact.website}</a></div>
					<div><strong>Location:</strong> {contact.location}</div>
				</div>
			</div>
		) : (
		<div class="contact-row">
			<span class="location">
				{!ats && (<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>)}
				{contact.location}
			</span>
			<a href={`mailto:${contact.email}`}>
				{!ats && (<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>)}
				{contact.email}
			</a>
			<a href={`https://${contact.github}`}>
				{!ats && (<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.373 0 12c0 5.303 3.438 9.8 8.205 11.387.6.113.82-.258.82-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>)}
				{contact.github}
			</a>
			<a href={`https://${contact.linkedin}`}>
				{!ats && (<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>)}
				{contact.linkedin}
			</a>
			<a href={`https://${contact.website}`}>
				{!ats && (<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/><line x1="2" y1="12" x2="22" y2="12"/></svg>)}
				{contact.website}
			</a>
		</div>
		)}
	</header>

	<!-- Summary -->
	<section>
		<h2>{ats && '> '}Summary</h2>
		<p class="summary" set:html={inline(resumeData.summary)} />
	</section>

	<!-- Skills -->
	<section>
		<h2>{ats && '> '}Technical Skills</h2>
		{resumeData.skills.map((group) => (
			<div class="skills-row">
				<span class="category">{group.category}:</span> {group.items.join(', ')}
			</div>
		))}
	</section>

	<!-- Experience: each job followed by its projects -->
	<section>
		<h2>{ats && '> '}Experience</h2>
		{resumeData.experience.map((job) => (
			<div class="job">
				<div class="job-head">
					<div class="entry-header">
						<h3>{job.role} at {job.company}</h3>
						<span class="period">{job.period}</span>
					</div>
					<div class="entry-sub">{job.location}</div>
					<div class="entry-desc" set:html={inline(job.description)} />
					{job.projects.length > 0 && <h4 class="projects-heading">Work Projects</h4>}
				</div>
				{job.projects.map((project: Project) => (
					<div class="project">
						<div class="project-header">
							<h5 class="project-title">• {project.name}{!ats && <> <span class="stage">[{stageLabel(project).toUpperCase()}]</span></>}</h5>
							{!ats && <span class="period">{project.period}</span>}
						</div>
						{ats && <div class="project-meta">{project.period} | {stageLabel(project)}</div>}
						<div class="project-desc" set:html={inline(project.description)} />
						{project.highlights?.length ? (
							<ul class="project-highlights">
								{project.highlights.map((h) => <li set:html={inline(h)} />)}
							</ul>
						) : null}
						<div class="project-tech"><span class="label">Tech &amp; Skills:</span> {project.tech.join(', ')}</div>
					</div>
				))}
			</div>
		))}
	</section>

	<!-- Education -->
	<section>
		<h2>{ats && '> '}Education</h2>
		{resumeData.education.map((edu) => (
			<div class="entry">
				<div class="entry-header">
					<h3>{edu.degree}, {edu.institution}</h3>
					<span class="period">{edu.period}</span>
				</div>
				<div class="entry-sub">{edu.location}{edu.grade ? ` · GPA: ${edu.grade}` : ''}</div>
				{edu.note && <div class="entry-note">{edu.note}</div>}
			</div>
		))}
	</section>

	<!-- Publications -->
	<section>
		<h2>{ats && '> '}Publications</h2>
		{resumeData.publications.map((pub) => (
			<div class="pub">
				<div class="pub-title">{pub.title}</div>
				<div class="pub-meta">{pub.venue}, {pub.year}{pub.note ? ` · ${pub.note}` : ''}</div>
			</div>
		))}
	</section>

</body>
</html>
