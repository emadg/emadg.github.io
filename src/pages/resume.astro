---
import { loadResume, renderInline, STAGE_LABEL, type Project } from '../lib/resume';
import defaultStyles from '../styles/resume-default.css?raw';
import atsStyles from '../styles/resume-ats.css?raw';

const resumeData = loadResume();
const contact = resumeData.basics;
const ats = process.env.RESUME_LAYOUT === 'ats';
const compact = ats && process.env.RESUME_DENSITY === 'compact';
// Keep formatting decisions local to the PDF; the portfolio keeps its emphasis.
const inline = (text: string | null | undefined) =>
	renderInline(ats ? text?.replace(/\*\*(.+?)\*\*/g, '$1') : text);
const stageLabel = (project: Project) => STAGE_LABEL[project.stage] ?? project.stage;
---

<!doctype html>
<html lang="en">
<head>
	<meta charset="UTF-8" />
	<title>{contact.name} - Resume</title>
	<meta name="author" content={contact.name} />
	<meta name="description" content={contact.headline} />
	<style is:inline set:html={ats ? atsStyles : defaultStyles}></style>
</head>
<body class:list={{ ats, clean: !ats, compact }} data-resume-layout={ats ? 'ats' : 'clean'}>

	<!-- Header -->
	<header>
		<div class="name-row">
			<h1>{contact.name}</h1>
			{compact ? (
				<div class="header-details">
					<span class="title">{contact.headline}</span>
					<span class="header-location">{contact.location}</span>
				</div>
			) : (
				<span class="title">{contact.headline}{ats && <><span class="title-separator"> — </span>{contact.location}</>}</span>
			)}
		</div>
		{ats ? (
			<div class="contact-info">
				<h2>Contact Info</h2>
				<div class="contact-row">
					<div><strong>Email:</strong> <a href={`mailto:${contact.email}`}>{contact.email}</a></div>
					<div><strong>GitHub:</strong> <a href={`https://${contact.github}`}>{contact.github}</a></div>
					<div><strong>LinkedIn:</strong> <a href={`https://${contact.linkedin}`}>{contact.linkedin}</a></div>
					<div><strong>Website:</strong> <a href={`https://${contact.website}`}>{contact.website}</a></div>
				</div>
			</div>
		) : (
		<div class="contact-row">
			<span class="location">
				{!ats && (<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>)}
				{contact.location}
			</span>
			<a href={`mailto:${contact.email}`}>
				{!ats && (<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>)}
				{contact.email}
			</a>
			<a href={`https://${contact.github}`}>
				{!ats && (<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.373 0 12c0 5.303 3.438 9.8 8.205 11.387.6.113.82-.258.82-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>)}
				{contact.github}
			</a>
			<a href={`https://${contact.linkedin}`}>
				{!ats && (<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>)}
				{contact.linkedin}
			</a>
			<a href={`https://${contact.website}`}>
				{!ats && (<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/><line x1="2" y1="12" x2="22" y2="12"/></svg>)}
				{contact.website}
			</a>
		</div>
		)}
	</header>

	<!-- Summary -->
	<section>
		<h2>Summary</h2>
		<p class="summary" set:html={inline(resumeData.summary)} />
	</section>

	<!-- Skills -->
	<section>
		<h2>Technical Skills</h2>
		{resumeData.skills.map((group) => (
			<div class="skills-row">
				<span class="category">{group.category}:</span> {group.items.join(', ')}
			</div>
		))}
	</section>

	<!-- Experience: each job followed by its projects -->
	<section>
		<h2>Experience</h2>
		{resumeData.experience.map((job) => (
			<div class="job">
				<div class="job-head">
					<div class="entry-header">
						{compact ? (
							<h3>{job.role} at {job.company}<span class="inline-meta"> — {job.period} | {job.location}</span></h3>
						) : (
							<><h3>{job.role} at {job.company}</h3><span class="period">{job.period}</span></>
						)}
					</div>
					{!compact && <div class="entry-sub">{job.location}</div>}
					<div class="entry-desc" set:html={inline(job.description)} />
					{job.projects.length > 0 && <h4 class="projects-heading">Work Projects</h4>}
				</div>
				{job.projects.map((project: Project) => (
					<div class="project">
						<div class="project-header">
							<h5 class="project-title">• {project.name}{ats ? <span class="inline-meta"> — {project.period} | {stageLabel(project)}</span> : <> <span class="stage">[{stageLabel(project).toUpperCase()}]</span></>}</h5>
							{!ats && <span class="period">{project.period}</span>}
						</div>
						<div class="project-desc" set:html={inline(project.description)} />
						{project.highlights?.length ? (
							<ul class="project-highlights">
								{project.highlights.map((h) => <li set:html={inline(h)} />)}
							</ul>
						) : null}
						<div class="project-tech"><span class="label">Tech &amp; Skills:</span> {project.tech.join(', ')}</div>
					</div>
				))}
			</div>
		))}
	</section>

	<!-- Education -->
	<section>
		<h2>Education</h2>
		{resumeData.education.map((edu) => (
			<div class="entry">
				<div class="entry-header">
					{compact ? (
						<h3>{edu.degree}, {edu.institution}<span class="inline-meta"> — {edu.period} | {edu.location}</span></h3>
					) : (
						<><h3>{edu.degree}, {edu.institution}</h3><span class="period">{edu.period}</span></>
					)}
				</div>
				{compact ? (
					(edu.grade || edu.note) && <div class="education-details">
						{edu.grade && <div>• GPA: {edu.grade}</div>}
						{edu.note && <div>• {edu.note}</div>}
					</div>
				) : (
					<>
						<div class="entry-sub">{edu.location}{edu.grade ? ` · GPA: ${edu.grade}` : ''}</div>
						{edu.note && <div class="entry-note">{edu.note}</div>}
					</>
				)}
			</div>
		))}
	</section>

	<!-- Publications -->
	<section>
		<h2>Publications</h2>
		{resumeData.publications.map((pub) => (
			<div class="pub">
				<div class="pub-title">{pub.title}</div>
				<div class="pub-meta">{pub.venue}, {pub.year}{pub.note ? ` · ${pub.note}` : ''}</div>
			</div>
		))}
	</section>

</body>
</html>
